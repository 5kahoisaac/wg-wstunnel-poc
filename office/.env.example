# ── Office box side ─────────────────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill in your own values.

# Same VPS public IP as vps/.env
VPS_IP=203.0.113.10

# MUST match vps/.env exactly
WS_SECRET=REPLACE_WITH_openssl_rand_hex_24

# Same subnet list as vps/.env (EXAMPLE values — change them)
OFFICE_ROUTES=10.50.0.0/16,10.60.0.0/16

# Next-hop gateway the office box uses to REACH those subnets.
# LEAVE EMPTY if the office box can already reach them natively
# (test: `curl http://<an-internal-ip>/` from the office box).
# If set (e.g. 10.50.0.1), make-office-conf.sh adds the matching static routes.
OFFICE_GW=
