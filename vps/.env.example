# ── VPS side ────────────────────────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill in your own values.
# `docker compose` reads `.env` automatically.

# Your VPS public IPv4. Get it on the VPS:  curl -4 -s ifconfig.me
VPS_IP=203.0.113.10

# Shared secret for the wss path. MUST be identical in vps/.env and office/.env.
# Generate once:  openssl rand -hex 24
WS_SECRET=REPLACE_WITH_openssl_rand_hex_24

# The internal subnets you want to reach, comma-separated CIDRs.
# Collapse your real subnets into supernets. These are EXAMPLE values — change them.
OFFICE_ROUTES=10.50.0.0/16,10.60.0.0/16
